PORT=4000
FRONTEND_URL=http://localhost:5173
# Leave DATABASE_URL unset to use the built-in local database.
# DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot
# REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string

# LLM (scoring, parsing alerts, drafting)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gmail OAuth (Google Cloud Console -> OAuth client, type: Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback

# Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=

# Worker: how often to check Gmail for new job alerts
SYNC_MINUTES=15
