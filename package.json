{
  "name": "jobpilot-launcher",
  "private": true,
  "workspaces": [
    "jobpilot/backend",
    "jobpilot/frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"npm run dev --workspace jobpilot-api\" \"npm run dev --workspace jobpilot-web\"",
    "worker": "npm run worker --workspace jobpilot-api",
    "migrate": "npm run migrate --workspace jobpilot-api",
    "infra:up": "docker compose -f jobpilot/docker-compose.yml up -d",
    "infra:down": "docker compose -f jobpilot/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
